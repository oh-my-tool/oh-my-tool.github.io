---
import type { Principle } from '../../data/site-content';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: Principle[];
}

const { eyebrow, title, description, items } = Astro.props;
---

<section class="section" id="principles">
  <div class="container">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{eyebrow}</div>
        <h2>{title}</h2>
      </div>
      <p>{description}</p>
    </div>
    <div class="principles">
      {items.map((item, index) => (
        <article class="principle">
          <div class="principle-number">0{index + 1}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
