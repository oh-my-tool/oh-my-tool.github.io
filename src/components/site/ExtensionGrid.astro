---
import type { Extension } from '../../data/site-content';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: Extension[];
}

const { eyebrow, title, description, items } = Astro.props;
---

<section class="section" id="extensions">
  <div class="container">
    <div class="section-heading">
      <div>
        <div class="section-kicker">{eyebrow}</div>
        <h2>{title}</h2>
      </div>
      <p>{description}</p>
    </div>
    <div class="extension-grid">
      {items.map((item) => (
        <a class="extension-card" href={item.href} target="_blank" rel="noreferrer" style={`--accent: var(--accent-${item.accent})`}>
          <div class="card-top">
            <span class="extension-name">{item.name}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </div>
          <div>
            <div class="package-name">{item.packageName}</div>
            <p>{item.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
